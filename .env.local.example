# Copy this file to .env.local and fill in your keys.
# All keys are server-side only — never exposed to the browser.

# Required — powers chat (llama-3.3-70b) and voice transcription (whisper-large-v3).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional — premium voice replies via ElevenLabs (free tier: ~10k credits/month).
# IMPORTANT: the key must have the "Text to Speech" permission enabled.
# Without a key, the site falls back to the browser's built-in speech synthesis.
ELEVENLABS_API_KEY=
# Optional — override the default ElevenLabs voice.
ELEVENLABS_VOICE_ID=

# Optional — override the chat model (default: llama-3.3-70b-versatile).
# Try "moonshotai/kimi-k2-instruct" for higher quality replies if available
# on your Groq account.
GROQ_MODEL=
